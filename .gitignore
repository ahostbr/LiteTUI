# ── Never commit: real conversation data ─────────────────────────
# .convos/<uuid>/ holds actual transcripts plus the agent's memory.md,
# soul.md and handoff.md. These are Ryan's conversations, not fixtures.
.convos/

# ── Never commit: screenshots ────────────────────────────────────
# A desktop capture can contain anything that was on screen.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp

# ── Per-machine / regenerable ────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# ── Agent/editor tool state, not the product ─────────────────────
.claude/
.codex/
.litesuite/
.liteeditor/
SCRATCHPAD/

# ── Runtime artefacts ────────────────────────────────────────────
*.log
tools/chrome-bridge/relay.pid
tools/chrome-bridge/shots/

# ── Per-machine settings, not the product ────────────────────
# settings.json is whatever this machine last saved in /settings — model
# choice, context length, sampling. Defaults live in settings.py.
settings.json

# Agent worktrees (git metadata lives in .git/worktrees; the checkout is not source)
.worktrees/
