# ── Never commit: real conversation data ─────────────────────────
# .convos/<uuid>/ holds actual transcripts plus the agent's memory.md,
# soul.md and handoff.md. These are Ryan's conversations, not fixtures.
.convos/

# ── Never commit: screenshots ────────────────────────────────────
# A desktop capture can contain anything that was on screen.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp

# ── Per-machine / regenerable ────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# ── Agent/editor tool state, not the product ─────────────────────
.claude/
.codex/
.litesuite/
.liteeditor/
SCRATCHPAD/

# ── Runtime artefacts ────────────────────────────────────────────
*.log
.logs/
tools/chrome-bridge/relay.pid
tools/chrome-bridge/shots/

# ── Per-machine settings, not the product ────────────────────
# settings.json is whatever this machine last saved in /settings — model
# choice, context length, sampling. Defaults live in settings.py.
settings.json

# Agent worktrees (git metadata lives in .git/worktrees; the checkout is not source)
.worktrees/

# Live runtime state at the repo root — same class as settings.json's
# carve-out. A `git add -A` must never commit a user's schedule.
jobs.json

# The skills index cache. Regenerated at boot and by `/skills refresh`, so it
# is per-machine state, not source — but it lands INSIDE skills/, which holds
# real tracked SKILL.md files, so the directory itself cannot be ignored. Named
# explicitly for that reason. It showed up as untracked in a worker's worktree
# minutes after it shipped, which is how the omission was found.
skills/index.json

# Stray editor/tool backups.
*.bak*
.llama/
e2e/artifacts/
# Prior-session agent scratch and session-private tooling — untracked by
# adjudication (Sentinel-delegated, 2026-08-21): not LiteTUI deliverables,
# bytes preserved on disk, never staged. Explicit paths, never add -A.
artifacts/
temp-working-dir/
tools/screenshot.py
# convo_search local index (77MB, rebuilt with `python tools/convo_search.py --reindex`);
# -wal/-shm covered by the glob. (T888, 2026-09-18)
tools/convo_search.db*

# Browser-monitor runtime artifacts (written to CWD by `litetui-monitor run/demo`).
# Source lives in src/litetui/monitor and tools/monitor; these are per-run outputs.
monitor-log.jsonl
monitor-shots/
monitor-baselines.json

# locally built sidecar binary (litetui-sidecar release)
bin/

# T982: per-install Codex routing id (never commit: public repo)
.codex_installation_id

# Docs are local-only (Ryan, liteask a-8c7fb080: "ignore the docs folder. It doesn't need to be pushed anymore.")
Docs/
docs/
