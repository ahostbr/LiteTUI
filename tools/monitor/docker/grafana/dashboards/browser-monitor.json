{
  "title": "Browser monitor",
  "uid": "browser-monitor",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["monitor", "browser"],
  "timezone": "browser",
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Targets up",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(browser_monitor_up)",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Slowest target (s)",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(browser_monitor_load_seconds)",
          "legendFormat": "max load"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Targets up / down (1 = up)",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "browser_monitor_up",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "boolean",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "points", "pointSize": 8 }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Page load time (s)",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "browser_monitor_load_seconds",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Visual regression (1 = changed vs baseline)",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "browser_monitor_changed",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "boolean",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "bars" }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Expectation met (1 = expected text present)",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "browser_monitor_expect_met",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "boolean",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "points" }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Visible text (chars)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "browser_monitor_text_chars",
          "legendFormat": "{{name}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        },
        "overrides": []
      }
    }
  ]
}
